{
  "name": "@hidden-leaf/media-kit-skill",
  "version": "0.3.0",
  "description": "Branded marketing image generation skill for Claude Code — produces HLN-style graphics via GPT image API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./SKILL.md": "./SKILL.md"
  },
  "files": [
    "dist",
    "scripts",
    "SKILL.md",
    "CLAUDE.snippet.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "media-kit",
    "marketing",
    "image-generation",
    "branding",
    "claude-code",
    "skill",
    "hidden-leaf"
  ],
  "author": "Hidden Leaf Networks",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hidden-Leaf-Networks/media-kit-skill.git"
  },
  "homepage": "https://github.com/Hidden-Leaf-Networks/media-kit-skill#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "openai": "^4.73.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
